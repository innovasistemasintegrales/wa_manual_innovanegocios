# ========== Cookies de Autenticación ==========
# Nombres para las cookies de usuarios internos y clientes
cookieUsuario=usuarioInnova              # Cookie principal para usuarios del sistema (soporte, técnico, admin)
cookieCliente=clienteInnova              # Cookie principal para clientes externos
cookieRefreshUsuario=refreshUsuarioInnova # Cookie de renovación para usuarios del sistema
cookieRefreshCliente=refreshClienteInnova # Cookie de renovación para clientes externos

# ========== Configuración JWT para Usuarios Internos ==========
# Credenciales JWT para usuarios del sistema (soporte, técnico y administrador)
JWT_SECRET=Ks*WQnz%fmfOa0odfzs*kEekX!@GNGTTeqIa2nAfyZ3@0dk5      # Clave secreta para firmar tokens
JWT_REFRESH_SECRET=ROSBSfe4ZKJvH*2EJGQn1*oT4AGgS2pOHw08Tk*FQ5DuO005 # Clave para tokens de renovación
JWT_EXPIRES_IN=1h                        # Tiempo de expiración del token principal
JWT_REFRESH_EXPIRES_IN=30d               # Tiempo de expiración del token de renovación

# ========== Configuración JWT para Clientes ==========
# Credenciales JWT para clientes externos 
CLIENTE_JWT_SECRET=xP7vMj2tKfL9@ZqRs5*Dn8Yb6EhG3wA1cQpUo4V       # Clave secreta para firmar tokens de clientes
CLIENTE_JWT_REFRESH_SECRET=Jg8$pL2mVz*6hXcK!9qWs@5rTyUb7nFd4AeQo3PzE # Clave para tokens de renovación de clientes
CLIENTE_JWT_EXPIRES_IN=1h                # Tiempo de expiración del token principal de clientes
CLIENTE_JWT_REFRESH_EXPIRES_IN=30d       # Tiempo de expiración del token de renovación de clientes

# ========== Configuración del Servidor ==========
PORT=2000                                # Puerto en el que se ejecutará la aplicación

# ========== Configuración de Base de Datos ==========
# Credenciales para la conexión con MySQL
DB_HOST=localhost                        # Dirección del servidor de base de datos
DB_NAME=db_manual_innova                 # Nombre de la base de datos
DB_USER=root                             # Usuario de la base de datos
DB_PASSWORD=''                           # Contraseña del usuario de la base de datos
