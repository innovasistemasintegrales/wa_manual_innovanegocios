                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h1 class="modal-title fs-5"></h1>
                            <button type="button" class="btn-close btn-cerrar-incidente" id="btnCerrarIncidente"
                                aria-label="Cerrar"></button>
                        </div>

                        <div class="modal-body">
                            <div class="contenedorModalIncidente"></div>
                            <template id="templateModalIncidente">

                                <div class="container-fluid text-dark">
                                    <div class="fila-box row">
                                        <div class="box col-12 col-lg-8 ms-auto">

                                            <div class="d-flex justify-content-between">
                                                <p class="item">Nro.<span class="numero-incidente"></span></p>
                                                <p class="item">Empresa<span class="empresa"></span></p>
                                            </div>
                                            <p class="nombre-incidente"></p>
                                        </div>

                                        <div class="box col ms-auto">
                                            <p class="item">Fecha</p>
                                            <p class="fecha" id="fechaIncidente"></p>
                                            <p class="hora" id="horaIncidente"></p>

                                        </div>

                                        <div class="box col ms-auto">
                                            <p class="item">Estado</p>
                                            <p class="estado"></p>
                                        </div>

                                    </div>
                                    <div class="fila-box2 row">
                                        <div class="box col-md-8 ms-auto">
                                            <p class="item">Detalles</p>
                                            <p class="detalles"></p>
                                        </div>
                                        <div class="box col ms-auto">
                                            <p class="item">Respuesta</p>
                                            <textarea type="text" rows="8" class="form-control input-style-1"
                                                wrap="hard" autofocus placeholder="Escribe aquí tu respuesta"
                                                required></textarea>
                                        </div>
                                    </div>
                                </div>
                            </template>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-cancelar" id="btnCerrarIncidente">Cerrar</button>
                            <button type="button" id="btnEnviarRespuestaIncidente" class="btn btn-primario">Enviar
                                respuesta a
                                Soporte</button>
                        </div>
                    </div>

                </div>
            </div>

            {{!--? Modal crear nuevo Incidente --}}
            <div class="modal-personalizado modal-incidente modal fade" data-bs-backdrop="static"
                id="modalNuevoIncidente" tabindex="-1" aria-labelledby="modalIncidenteLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h1 class="modal-title fs-5"></h1>
                            <button type="button" class="btn-close btn-cerrar-incidente" id="btnCancelarNuevoIncidente"
                                aria-label="Cerrar"></button>
                        </div>

                        <div class="modal-body">
                            <div class="contenedorModalNuevoIncidente"></div>


                            <template id="templateModalNuevoIncidente">

                                <div class="container-fluid text-dark">
                                    <div class="fila-box row">
                                        <div class="box col-12 col-lg-8 ms-auto">

                                            <div class="d-flex justify-content-between">
                                                <p class="item">Nro.<span class="numero-incidente"></span></p>
                                                <p class="item">Empresa<span class="empresa"></span></p>
                                            </div>
                                            <input placeholder="Resumen del Incidente"
                                                class="form-control input-style-1" id="tituloNuevoIncidente">
                                        </div>

                                        <div class="box col ms-auto">
                                            <p class="item">Fecha</p>
                                            <p class="fecha" id="fechaNuevoIncidente"></p>
                                            <p class="hora" id="horaNuevoIncidente"></p>
                                        </div>

                                        <div class="box col ms-auto">
                                            <p class="item">Estado</p>
                                            <p class="estado"></p>
                                        </div>

                                    </div>
                                    <div class="fila-box2 row">
                                        <div class="box col-md-8 ms-auto">
                                            <p class="item">Descripción del problema</p>
                                            <textarea type="text" rows="10" class="form-control  input-style-1"
                                                placeholder="Describe aquì tu problema" id="descripcionNuevoIncidente"
                                                required></textarea>
                                        </div>
                                        <div class="box col ms-auto">
                                            <p class="item"><i class="bi bi-images"></i> Adjuntar Imàgenes (opcional)
                                            </p>
                                            <input class="form-control input-style-1" type="file"
                                                id="filesNuevoIncidente" accept=".jpg,.gif,.png" multiple>

                                        </div>
                                    </div>
                                </div>
                            </template>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-cancelar"
                                id="btnCancelarNuevoIncidente">Cancelar</button>
                            <button type="button" id="btnCrearNuevoIncidente" class="btn btn-success">Enviar
                                Incidente</button>
                        </div>
                    </div>

                </div>
            </div>

            {{!--? Contenedor general de Toasts --}}
            <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
            </div>

        </div>

    </section>

</div>

