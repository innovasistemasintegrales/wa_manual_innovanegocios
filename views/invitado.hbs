{{!-- Contenedor principal --}}
<section id="contenedorPrincipal">
    <div class="row m-0">


        {{!--TODO Card reactivo --}}
        <div id="cardReactivo">
        </div>

        {{!--TODO Template preguntas frecuentes --}}
        <template id="templateInicio">
            <div class="container-lg px-0 px-lg-5">
                                <div id="cardIndicadorDashboard" class="row d-flex justify-content-evenly card-mode">
                    <H2 class="col-12 text-center text-black fw-bold mb-3">Gestión de Usuarios</H2>
                    <div class="col-auto text-center p-3 card-indicador card-colo1">
                        <div class="d-flex justify-content-between">
                            <img src="/img/pendientes.png" alt="" width="60px">
                            <span id="cantidadUsuariosADMINISTRADOR"
                                class="indicador-num-administradores mt-2">12</span>
                        </div>
                        <div class="pt-1">
                            <span>ADMINISTRADORES</span>
                        </div>
                    </div>
                    <div class="col-auto text-center p-3 card-indicador card-colo2">
                        <div class="d-flex justify-content-between">
                            <img src="/img/enCurso.png" alt="" width="50px">
                            <span id="cantidadUsuariosTECNICO" class="indicador-num-tecnico mt-2">12</span>
                        </div>
                        <div class="pt-3">
                            <span>TÉCNICOS</span>
                        </div>
                    </div>
                    <div class="col-auto text-center p-3 card-indicador card-colo3">
                        <div class="d-flex justify-content-between">
                            <img src="/img/resueltos.png" alt="" width="50px">
                            <span id="cantidadUsuariosSOPORTE" class="indicador-num-soporte mt-2">12</span>
                        </div>
                        <div class="pt-3">
                            <span>SOPORTE</span>
                        </div>
                    </div>
                    <div class="col-auto text-center p-3 card-indicador card-colo4">
                        <div class="d-flex justify-content-between">
                            <img src="/img/total.png" alt="" width="50px">
                            <span id="cantidadUsuariosCLIENTE" class="indicador-num-clientes mt-2">12</span>
                        </div>
                        <div class="pt-3">
                            <span>CLIENTES</span>
                        </div>
                    </div>
                </div>

                <div class="row p-0 m-0">
                    <div class="col-0 p-0">

                        <div class="card-mode-transparent p-3">
                            <div
                                class="contenedor-preguntas-frecuentes d-flex flex-column justify-content-start align-items-center">
                                <h3 class="text-center fw-bold text-white my-3">Preguntas Frecuentes</h3>
                                <div class="contenedor-accordion">

                                    <div class="accordion accordion-flush" id="contenedorPreguntasFrecuentes">

                                    </div>

                                    <template id="templateItemPreguntaFrecuente">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header">
                                                <button
                                                    class="accordion-button d-flex flex-wrap justify-content-between gap-1 gap-sm-3 collapsed"
                                                    type="button" data-bs-toggle="collapse"
                                                    data-bs-target="#collapseOne" aria-expanded="false"
                                                    aria-controls="collapseOne">

                                                    <input class="fw-bold flex-grow-1 me-3 d-none px-3 question-input"
                                                        type="text" value="" placeholder="Nueva pregunta..." disabled>

                                                    <span class="fw-bold flex-grow-1 px-3 question-text"
                                                        id="pregunta"></span>

                                                    {{!-- <span
                                                        class="badge rounded bg-success ms-0 ms-sm-auto px-3 py-2">Vistas:
                                                        32</span>

                                                    <span
                                                        class="badge rounded bg-secondary px-3 py-2 date-badge">Creado/modificado:
                                                        02/11/2024</span> --}}

                                                </button>
                                            </h2>
                                            <div id="collapseOne" class="accordion-collapse collapse"
                                                data-bs-parent="#contenedorPreguntasFrecuentes">
                                                <div class="accordion-body">
                                                    <textarea type="text" class="answer-text" rows="6"
                                                        placeholder="Escribe aquí la respuesta..." id="respuesta"
                                                        disabled></textarea>

                                                    <div class="d-flex flex-wrap gap-2 justify-content-end mt-0">

                                                        {{!--! No eliminar o modificar las clases porque están
                                                        vinculadas con el javascript
                                                        --}}


                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </template>

                                    <div id="divSinPreguntas">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="textoAnimado" class="text-center cinta-movil px-0">
                <marquee behavior="run" direction="left" scrolldelay="0.2" loop="infinite">
                    <h3 class="fw-bold">Las grandes oportunidades nacen de haber sabido aprovechar las pequeñas</h3>
                </marquee>
            </div>
        </template>

        {{!--TODO Template manuales --}}
        <template id="templateManuales">
            <div class="container-lg px-0 px-lg-5">
                <div class="row p-0 m-0">
                    <div class="col-0 p-0 ">
                        <div class="card-mode card-manual-usuario row">
                            <!-- Encabezado Bienvenida -->
                            <div class="col-12 text-center my-2 fw-bold ">
                                <h2>Bienvenido al manual de usuario</h2>
                            </div>

                            <div class="manual-seccion col-12 col-md-4 p-0 d-flex flex-column gap-2">
                                <div class="accordion" id="contenedorTitulosManuales">
                                    <template id="templateItemTituloManual">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="headingOne">
                                                <button class="accordion-button manual-title" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#collapseOne"
                                                    aria-expanded="true" aria-controls="collapseOne" id="tituloManual">
                                                    Accordion Tittle
                                                </button>
                                            </h2>
                                            <div id="collapseOne" class="accordion-collapse collapse show"
                                                aria-labelledby="headingOne"
                                                data-bs-parent="#contenedorTitulosManuales">
                                                <div class="accordion-body d-flex flex-column gap-1">
                                                    <div id="contenedorSubtitulos"
                                                        class="d-flex flex-column gap-1 w-100 h-100">
                                                    </div>
                                                    <template id="templateItemSubtituloManual">
                                                        <div class="btn-group p-0" role="group">
                                                            <input type="radio" id="menu-subtitulo-1"
                                                                name="menu-manual-subtitulos" class="d-none">
                                                            <label
                                                                class="btn text-start btn-mostrar-contenido-subtitulo"
                                                                for="menu-subtitulo-1">
                                                                Nuevo Subtítulo
                                                            </label>
                                                        </div>
                                                    </template>
                                                    <div class="d-flex gap-1 justify-content-center w-100">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>

                            <div id="contenedorContenidoManuales" class="manual-contenido col-12 col-md-8 px-0">
                                <template id="templateItemContenidoManual">
                                    <div class="mb-3 text-center">
                                        <input type="text"
                                            class="form-control subtitulo-manual border-0 bg-transparent text-center d-flex align-items-center"
                                            id="subtitulo-manual" style="font-size: 1.5rem; font-weight: bold;"
                                            disabled>
                                    </div>
                                    <div class="mb-3 text-center">
                                        <textarea
                                            class="form-control introduccion-manual border-0 bg-transparent text-center d-flex align-items-center"
                                            id="introduccion-manual" style="height: 120px" disabled></textarea>
                                    </div>

                                    <!-- Video Section -->
                                    <div class="mb-3">
                                        <input type="text" class="form-control link-video-manual" id="link-video-manual"
                                            disabled>
                                        <label for="link-video-manual">Link del Video</label>
                                    </div>
                                    <div class="video-manual mb-3">
                                        <!-- El src debe ser un enlace embebido válido -->
                                        <iframe id="video-manual" class="w-100" width="100%" height="315"
                                            frameborder="0" allowfullscreen></iframe>
                                    </div>

                                    <!-- PDF Section -->
                                    <div class="pdf-manual mb-3">
                                        <!-- Mostramos el PDF sin necesidad de abrir otra pestaña -->
                                        <embed id="embed-pdf-manual" src="" type="application/pdf" width="100%"
                                            height="400">
                                    </div>

                                    <div class="d-flex gap-2 mb-3 justify-content-end acciones-contenido-manual">
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        {{!--? Contenedor general de Toasts --}}
        <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
        </div>

    </div>

</section>

<script type="module" src="/js/invitado.js"></script>