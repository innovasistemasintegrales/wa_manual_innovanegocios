<div
  class="container-login vh-100 vw-100 d-flex flex-column flex-md-row justify-content-center align-items-center fix-login-body-margin-50">

  <div class="logo-innova">
    <img src="/img/svg/innova-sistemas-integrales-1 2.svg" alt="" class="img-fluid">
  </div>

  <section id="bienvenidaLogin" class="d-none d-md-flex flex-column align-items-center justify-content-center">

    <div class="p-4">

      <span class="fw-light text-white fs-5">
        Bienvenido al
      </span><br>
      <h1 class="text-white fs-1">
        Manual y Soporte de Innova
      </h1>

      <img src="/img/svg/login-image.svg" alt="" class="img-fluid pt-4">

    </div>
  </section>

  <section id="login" class="">

    <div class="contenedor-login">



      <div class="card-login d-flex shadow">
        <div class="row d-flex justify-content-center">

          <form id="formularioLogin" action="" class="form-group">
            <div>
              <h2 class="text-center fs-2 fs-md-4 mt-0 p-0 color-1 fw-bold">

                <span class="fw-light fs-4 color-primario">
                  Bienvenido al <br>

                </span>
                Manual y Soporte de Innova
              </h2>

              <div class="text-center mb-4">
                <h4 class="color-primario fw-bold">
                  Ingresa con tu Cuenta Innova
                </h4>
              </div>

              <div>
                <input id="correoSesion" class="inputs form-control mb-3 text-black" type="text"
                  placeholder="Correo del usuario" />
              </div>
              <div>
                <input id="passwordSesion" class="inputs form-control mb-3" type="password" placeholder="Contraseña" />
              </div>
              <div>
                <a href="#"><span class="btn btn-color-1 mt-2 w-100 mb-3" onclick="validarUsuario()">Ingresar</span></a>
              </div>
              <div class="row d-lg-flex justify-content-between">
                <div class="col-auto">
                  <span class="my-3 border-bottom transition-puntero" href="" data-bs-toggle="modal"
                    data-bs-target="#modalRecuperacion">Olvide Contraseña</span>
                </div>
                <div class="col-auto text-lg-end">
                  <span class="my-3 border-bottom transition-puntero" href="" data-bs-toggle="modal"
                    data-bs-target="#modalRegistro">Registrarse</span>
                </div>
              </div>
            </div>

          </form>

          <!-- Modal de registro de cliente -->
          <div class="modal fade" id="modalRegistro" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
            aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="staticBackdropLabel">Registro de datos</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body modalData">
                  <div class="p-4">
                    <label for="">Correo (Sera tu usuario para iniciar sesion)</label>
                    <input id="correoRegistro" class="form-control mb-3" type="text" />
                    <label for="">Contraseña</label>
                    <input id="passwordRegistro" class="form-control mb-3" type="password" />
                    <span class="lbx-datos-select nav-link dropdown-toggle border border-1 rounded-2 mb-3 text-dark"
                      data-bs-toggle="dropdown" role="button" aria-expanded="false">Seleccione tipo documento</span>
                    <ul class="dropdown-menu">
                      <li><a class="dropdown-item lbx-datos op-ruc">RUC</a></li>
                      <li><a class="dropdown-item lbx-datos op-dni">DNI</a></li>
                      <li><a class="dropdown-item lbx-datos op-otro">OTRO</a></li>
                    </ul>
                    <div id="contenedorDatos">

                    </div>
                    <label for="">Dirección</label>
                    <input id="direccion" class="form-control mb-3" type="text" />
                    <label for="">Telefono</label>
                    <input id="telefono" class="form-control mb-3" type="number" />
                    {{! <div>
                      <select name="cliente" class="form-select form-select-sm" aria-label="Default select example">
                        <option selected class="border-bottom">Tipo de cliente</option>
                        <option value="1">Mayorista</option>
                        <option value="2">Cliente Final</option>
                      </select>
                    </div> }}
                  </div>
                </div>
                <div class="modal-footer">
                  <span type="button" class="btn style-btn-afirmar btn-guardar-registro">Guardar Datos</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Modal de recuperación de contraseña -->
          <div class="modal fade" id="modalRecuperacion" data-bs-backdrop="static" data-bs-keyboard="false"
            tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="staticBackdropLabel">Recuperar
                    contraseña</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body modalData">
                  <div class="p-4">
                    <label for="">Ingrese correo que haya sido registrado</label>
                    <input id="correoRecuperacion" class="form-control mb-3" type="text" />
                  </div>
                </div>
                <div class="modal-footer">
                  <span type="button" class="btn style-btn-afirmar btn-recueprar-password">Validar y Recuperar</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <div class="login-invitado mt-2 ms-auto align-self-end">
        <p class="btn btn-login-invitado">Ingresar como invitado →</p>
      </div>
    </div>
  </section>

</div>
<script src="/js/login.js"></script>