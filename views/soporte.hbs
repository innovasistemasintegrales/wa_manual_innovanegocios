              <div class="modal-body">
                <div class="container">

                  {{!-- Selección de Rol de Usuario --}}
                  <div
                    class="form-check divSeleccionRol d-flex justify-content-between px-3 pt-4 pb-3 flex-column flex-sm-row gap-2 mt-2"
                    id="divSeleccionRolNewUser">
                    <p
                      class="text-dark position-absolute top-0 start-50 translate-middle-x text-center fw-bold bg-white rounded-pill px-2">
                      Seleccione el rol de usuario</p>

                    <input type="radio" class="btn-check" name="seleccionRol" id="rolAdministrador" autocomplete="off">
                    <label class="btn" for="rolAdministrador">Administrador</label>

                    <input type="radio" class="btn-check" name="seleccionRol" id="rolTecnico" autocomplete="off">
                    <label class="btn" for="rolTecnico">Técnico TI</label>

                    <input type="radio" class="btn-check" name="seleccionRol" id="rolSoporte" autocomplete="off">
                    <label class="btn btn-outline-primary" for="rolSoporte">Soporte</label>

                    <input type="radio" class="btn-check" name="seleccionRol" id="rolCliente" autocomplete="off">
                    <label class="btn" for="rolCliente">Cliente</label>
                  </div>

                  {{!-- Foto NOmbre y correo --}}
                  <div
                    class="position-relative d-flex flex-column flex-sm-row align-items-center datos-usuario justify-content-between">
                    <img id="imgPerfilNewUser" src="/img/perfil.png" alt="Foto de Perfil" class="foto-perfil-usuario">

                    <!-- Imagen de perfil con input file -->
                    <div class="position-absolute d-none">
                      <label for="addImgNewUser">+</label>
                      <input type="file" name="foto-perfil" accept="image/jpeg, image/png" />
                      <div class="invalid-feedback"></div>
                    </div>

                    {{!-- Nombre y correo --}}
                    <div
                      class="d-flex flex-column justify-content-center align-items-center align-items-sm-start ms-sm-3 gap-1">

                      <input type="text" class="form-control nombre-usuario mb-0 fw-bold text-sm-start"
                        id="nombreNewUser" placeholder="Nombres" required>
                      <div class="invalid-feedback"></div>
                      <input type="text" class="form-control apellido-usuario mb-0 fw-bold text-sm-start"
                        id="apellidoNewUser" placeholder="Apellidos" required>
                      <div class="invalid-feedback"></div>

                      <input type="email" class="form-control form-control-sm text-sm-start " id="correoNewUser"
                        placeholder="Correo electrónico" required>
                      <div class="invalid-feedback"></div>

                    </div>

                  </div>

                  {{!-- Usuario y contraseña --}}
                  <div class="d-flex flex-column align-items-center datos-usuario datos-usuario-contraseña gap-1">
                    <div>
                      <label for="usuario">Usuario:</label>
                      <input class="form-control" id="userNewUser" type="text" required>
                    </div>
                    <div>
                      <label for="password">Contraseña:</label>
                      <input class="form-control" type="password" id="passwordNewUser" required>
                    </div>
                  </div>

                  {{!-- telef - direccion - fecha ingreso - dirección - estado--}}
                  <div class="d-flex flex-column align-items-center datos-usuario gap-1 text-black">
                    <div>
                      <label for="dni">DNI:</label>
                      <input class="form-control" id="dniNewUser" pattern="\d{8}" title="Debe contener 8 dígitos"
                        type="text" required>
                      <div class="invalid-feedback"></div>
                    </div>
                    <div>
                      <label for="telefono">Teléfono:</label>
                      <input class="form-control" type="tel" id="telefonoNewUser" required>
                      <div class="invalid-feedback"></div>
                    </div>
                    <div>
                      <label for="direccion">Dirección:</label>
                      <input class="form-control" type="text" id="direccionNewUser" required>
                      <div class="invalid-feedback"></div>
                    </div>
                    <div>
                      <label for="nacimiento">Nacimiento:</label>
                      <input class="form-control" type="date" id="nacimientoNewUser" placeholder="(opcional)">
                    </div>
                    <div>
                      <label for="estado">Estado:</label>
                      <select class="form-select" id="estadoNewUser" aria-label="Estado del usuario seleccionado">
                        <option value="Activo" selected>Activo</option>
                        <option value="Inactivo">Inactivo</option>
                      </select>
                    </div>

                  </div>

                </div>
              </div>

