{{!-- Contenedor principal --}}
<section id="contenedorPrincipal">
  <div class="row m-0">
    <div class="col p-0  position-relative">

      {{!--TODO Card reactivo --}}
      <div id="cardReactivo">
        <div class="container-xl px-0 px-lg-5">

          <div id="cardIndicadorDashboard" class="row d-flex justify-content-evenly card-mode">
            <H2 class="col-12 text-center text-black fw-bold mb-3">Gestión de Usuarios</H2>
            <div class="col-auto text-center p-3 card-indicador card-colo1">
              <div class="d-flex justify-content-between">
                <img src="/img/pendientes.png" alt="" width="60px">
                <span id="cantidadUsuariosADMINISTRADOR" class="indicador-num-administradores mt-2">12</span>
              </div>
              <div class="pt-1">
                <span>ADMINISTRADORES</span>
              </div>
            </div>
            <div class="col-auto text-center p-3 card-indicador card-colo2">
              <div class="d-flex justify-content-between">
                <img src="/img/enCurso.png" alt="" width="50px">
                <span id="cantidadUsuariosTECNICO" class="indicador-num-tecnico mt-2">12</span>
              </div>
              <div class="pt-3">
                <span>TÉCNICOS</span>
              </div>
            </div>
            <div class="col-auto text-center p-3 card-indicador card-colo3">
              <div class="d-flex justify-content-between">
                <img src="/img/resueltos.png" alt="" width="50px">
                <span id="cantidadUsuariosSOPORTE" class="indicador-num-soporte mt-2">12</span>
              </div>
              <div class="pt-3">
                <span>SOPORTE</span>
              </div>
            </div>
            <div class="col-auto text-center p-3 card-indicador card-colo4">
              <div class="d-flex justify-content-between">
                <img src="/img/total.png" alt="" width="50px">
                <span id="cantidadUsuariosCLIENTE" class="indicador-num-clientes mt-2">12</span>
              </div>
              <div class="pt-3">
                <span>CLIENTES</span>
              </div>
            </div>
          </div>

          {{!--? Tabla de Últimos Incidentes --}}
          <div class="card-mode card-incidentes">
            <h3 class="text-center fw-bold">Ultimos Incidentes</h3>

            <div class="cabezaTabla">
              <div class="cabezaTabla-numero">Nro.</div>
              <div class="cabezaTabla-incidente">Incidente</div>
              <div class="cabezaTabla-detalles">Detalles</div>
              <div class="cabezaTabla-nombre-empresa">Empresa</div>
              <div class="cabezaTabla-fecha">Fecha</div>
              <div class="cabezaTabla-estado">Estado</div>
              <div class="cabezaTabla-opciones">Opciones</div>
            </div>
            <div class="lista-ultimos-incidentes">

            </div>

            {{!-- Footer de la tabla --}}
            <div
              class="footer-tabla d-flex justify-content-center align-items-center gap-2 flex-wrap mt-2 px-2 rounded-5 bg-light">
              <p class="text-dark">Mostrando <span id="mostrandoIncidentes">0</span> de <span
                  id="totalIncidentes">0</span> registros</p>
              <button id="btnCargarMasIncidentes" class="btn btn-sm btn-dark ">Cargar más incidentes</button>
            </div>


          </div>



        </div>
        <div id="textoAnimado" class="text-center cinta-movil px-0">
          <marquee behavior="run" direction="left" scrolldelay="0.2" loop="infinite">
            <h3 class="fw-bold">Las grandes oportunidades nacen de haber sabido aprovechar las pequeñas</h3>
          </marquee>
        </div>
      </div>

      {{!--TODO Template incidentes --}}
