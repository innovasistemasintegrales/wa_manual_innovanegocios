        <template id="templateConfiguracion">
          <div class="container-fluid container-configuracion d-flex justify-content-center align-items-center  px-0">

            <div id="editarUsuarioConfiguracion"
              class="container modal-usuario modal-usuario-configuracion card-dashboard my-3">

              {{!-- Rol de Usuario --}}
              <div class="d-flex justify-content-center bg-dark p-1 mb-3 datos-usuario">
                <p class="fs-3 text-center" id="rolUsuario">TÉCNICO</p>
              </div>

              {{!-- Foto --}}
              <div
                class="position-relative d-flex flex-column flex-sm-row align-items-center datos-usuario justify-content-between">
                <img id="imgUsuario" src="/img/perfil.png" alt="Foto de Perfil" class="foto-perfil-usuario">

                <!-- Imagen de perfil con input file -->
                <div class="position-absolute d-none" id="custom-image-container">
                  <label id="addImgUsuario" for="addImg">+</label>
                  <input type="file" id="addImg" name="foto-perfil" accept="image/jpeg, image/png"
                    onchange="previewImagenPerfil(event)" />
                  <div class="invalid-feedback"></div>
                </div>

                {{!-- Nombre y correo --}}
                <div
                  class="d-flex flex-column justify-content-center align-items-center align-items-sm-start ms-sm-3 gap-1">

                  <input type="text" class="form-control nombre-usuario mb-0 fw-bold text-sm-start" id="nombreUsuario"
                    placeholder="Nombre completo" required disabled>
                  <div class="invalid-feedback"></div>

                  <input type="email" class="form-control form-control-sm text-start" id="correoUsuario"
                    placeholder="Correo electrónico" required disabled>
                  <div class="invalid-feedback"></div>

                </div>

              </div>

              {{!-- Usuario y contraseña --}}
              <div class="d-flex flex-column align-items-center datos-usuario datos-usuario-contraseña gap-1">
                <div>
                  <label for="usuario">Usuario:</label>
                  <input class="form-control" id="userUsuario" type="text" required disabled>
                </div>
                <div>
                  <label for="password">Contraseña:</label>
                  <input class="form-control" type="password" id="passwordUsuario" required disabled>
                </div>
              </div>

              {{!-- telef - direccion - fecha ingreso - dirección - estado--}}
              <div class="d-flex flex-column align-items-center datos-usuario gap-1 text-black">
                <div>
                  <label for="dni">DNI:</label>
                  <input class="form-control" id="dniUsuario" pattern="\d{8}" title="Debe contener 8 dígitos"
                    type="text" required disabled>
                  <div class="invalid-feedback"></div>
                </div>
                <div>
                  <label for="telefono">Teléfono:</label>
                  <input class="form-control" type="tel" id="telefonoUsuario" required disabled>
                  <div class="invalid-feedback"></div>
                </div>
                <div>
                  <label for="direccion">Dirección:</label>
                  <input class="form-control" type="text" id="direccionUsuario" required disabled>
                  <div class="invalid-feedback"></div>
                </div>
                <div>
                  <label for="fecha-ingreso">Fecha de ingreso:</label>
                  <input class="form-control" type="date" id="fechaIngresoUsuario" disabled required>
                  <div class="invalid-feedback"></div>
                </div>
                <div>
                  <label for="nacimiento">Nacimiento:</label>
                  <input class="form-control" type="date" id="nacimientoUsuario" placeholder="(opcional)" disabled>
                </div>
                <div>
                  <label for="estado">Estado:</label>
                  <select class="form-select" id="estadoUsuario" aria-label="Estado del usuario seleccionado" disabled>
                    <option value="Activo" selected>Activo</option>
                    <option value="Suspendido">Suspendido</option>
                    <option value="Abandonado">Abandonado</option>
                  </select>
                </div>

              </div>

              <!-- Botones de acción -->
              <div class="d-flex justify-content-end mt-3 gap-2">
                <button id="editButton" class="btn btn-color-1">Editar</button>
                <button id="cancelButton" class="btn btn-primario d-none">Cancelar</button>
                <button id="saveButton" class="btn btn-success d-none" disabled>Guardar
                  cambios</button>
              </div>

            </div>


          </div>
        </template>

